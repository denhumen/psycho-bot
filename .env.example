# Скопіюйте у .env і заповніть. Реальні значення в репозиторій не комітити.

# Токен бота від @BotFather. Для локальної перевірки — окремий тестовий бот.
BOT_TOKEN=
# Шлях до SQLite. На Railway — volume, змонтований у /data.
DATABASE_PATH=./data/study.db
# Секрет для підпису cookie адмінки, щонайменше 32 випадкові символи:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Railway підставляє PORT сам.
PORT=8000
TIMEZONE=Europe/Kyiv

# whitelist — приймати лише коди, завантажені в адмінці (/codes); open — будь-який код за CODE_REGEX.
CODE_VALIDATION=whitelist
# Формат коду (перевіряється після trim + upper).
CODE_REGEX=^[A-Za-zА-Яа-яІіЇїЄєҐґ0-9_-]{4,32}$
# Варіанти часу нагадувань (за Києвом), через кому.
REMINDER_TIME_OPTIONS=09:00,12:00,15:00,18:00,20:00,21:00
# Перша інструкція — через N днів після «Готовий почати».
START_OFFSET_DAYS=1
# Авто-нагадування через N годин після інструкції, якщо чек-ін не пройдено; 0 = вимкнено.
AUTO_REMINDER_AFTER_HOURS=3
# Посилання на фінальну форму; {code} буде замінено на URL-encoded код учасника.
POST_SURVEY_URL_TEMPLATE=https://docs.google.com/forms/d/e/XXX/viewform?entry.123={code}

# Чат для щоденного дайджесту (агрегати). Порожньо — дайджест вимкнено.
ADMIN_CHAT_ID=
# Приватний чат owner для нічного бекапу БД. Бекап містить розподіл груп! Порожньо — бекап у Telegram вимкнено.
BACKUP_CHAT_ID=
# Час бекапу і дайджесту за Києвом.
BACKUP_TIME=03:00
DIGEST_TIME=09:00
# Показується в /help і в повідомленнях про помилки коду.
SUPPORT_CONTACT=@study_support

# Блокова рандомізація: розмір блоку (парний) і кількість блоків при першому старті.
ALLOCATION_BLOCK_SIZE=4
ALLOCATION_INITIAL_BLOCKS=100

# Cookie адмінки лише через HTTPS. Для локального запуску по http — false.
COOKIE_SECURE=true
# ТІЛЬКИ ДЛЯ ЛОКАЛЬНОЇ ПЕРЕВІРКИ: тривалість «дня» дослідження в хвилинах.
# Порожньо в продакшені.
DEV_DAY_MINUTES=
LOG_LEVEL=INFO
